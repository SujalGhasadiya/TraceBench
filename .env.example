# Gemini API Key (leave empty for deterministic Demo Mode)
GEMINI_API_KEY=
# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Configuration
TRACEBENCH_HOST=127.0.0.1
TRACEBENCH_PORT=8000
TRACEBENCH_WORKSPACE_DIR=./data/workspaces
TRACEBENCH_MAX_UPLOAD_SIZE_MB=50
TRACEBENCH_MAX_EXTRACTED_SIZE_MB=150
TRACEBENCH_MAX_FILE_COUNT=2000
TRACEBENCH_MAX_FILE_SIZE_BYTES=1048576

# Allowed Frontend Origins (CORS)
TRACEBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
